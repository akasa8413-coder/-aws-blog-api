{
  "name": "aws-blog-api",
  "version": "1.0.0",
  "description": "A secure blog API built with TypeScript and AWS",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "node --import tsx --test tests/security.test.ts",
    "test:integration": "node --import tsx --test tests/integration.test.ts",
    "db:generate": "prisma generate --config prisma7.config.ts",
    "db:migrate": "prisma migrate deploy --config prisma7.config.ts"
  },
  "keywords": [
    "typescript",
    "express",
    "aws",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.9",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "jose": "^6.2.17",
    "pg": "^8.23.1",
    "prisma": "^7.10.0"
  }
}
